<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Product Catalog</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar">

            <div class="container nav-container">

                <a class="brand" asp-controller="Home" asp-action="Index">
                    PRODUCT CATALOG
                </a>

                <div class="nav-links">

                    <a asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>

                    <a asp-controller="Product"
                       asp-action="Index">
                        Products
                    </a>

                    <a asp-controller="Home"
                       asp-action="Privacy">
                        Privacy
                    </a>

                </div>

            </div>

        </nav>
    </header>

    <main class="main-content">

        @RenderBody()

    </main>

    <footer class="footer">

        <div class="container">
            <p>
                &copy; 2026 Product Catalog |
                ASP.NET Core MVC
            </p>
        </div>

    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>