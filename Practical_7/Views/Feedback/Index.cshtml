@model FeedbackManagement.Models.Feedback

@{
    ViewData["Title"] = "Feedback Management";
}

<div class="container mt-4">
    <div class="card shadow p-4 mx-auto" style="max-width: 650px;">
        <h2 class="text-center mb-3">Feedback Management</h2>
        <p class="text-muted text-center">
            Share your feedback and help us improve.
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        <partial name="_FeedbackForm" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
